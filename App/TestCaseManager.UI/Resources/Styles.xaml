<!--
    Zentrales Design der Anwendung.
    Farbwerte stammen aus einer validierten, farbfehlsichtigkeits-geprüften
    Referenzpalette (Akzent-Blau als einzelne Sequenzfarbe, reservierte
    Statusfarben). Status wird nie ausschließlich über Farbe codiert -
    Textlabels sind immer vorhanden.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TestCaseManager.UI.Controls">

    <!-- ===== Konverter ===== -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ===== Farben: Flächen und Schrift (Ink) ===== -->
    <SolidColorBrush x:Key="PageBrush" Color="#F9F9F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFCFB" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="#0B0B0B" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#52514E" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#898781" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#E1E0D9" />
    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#1A0B0B0B" />
    <SolidColorBrush x:Key="HoverWashBrush" Color="#F1F0EA" />

    <!-- ===== Farben: Akzent (Blau, sequenzielle Referenzfarbe) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2A78D6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#256ABF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1C5CAB" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#CDE2FB" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#E5F0FC" />

    <!-- ===== Farben: Status (reserviert, immer mit Textlabel) ===== -->
    <SolidColorBrush x:Key="StatusDraftBrush" Color="#898781" />
    <SolidColorBrush x:Key="StatusInReviewBrush" Color="#FAB219" />
    <SolidColorBrush x:Key="StatusActiveBrush" Color="#0CA30C" />
    <SolidColorBrush x:Key="StatusInactiveBrush" Color="#EC835A" />
    <SolidColorBrush x:Key="StatusDeprecatedBrush" Color="#D03B3B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D03B3B" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B63232" />

    <!-- ===== Effekte (weiche Elevation) ===== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                      Direction="270" Opacity="0.10" Color="#0B0B0B" RenderingBias="Quality" />
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="3"
                      Direction="270" Opacity="0.16" Color="#0B0B0B" RenderingBias="Quality" />

    <!-- ===== Typografie ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    </Style>

    <!-- ===== Hilfe: kleines Fragezeichen mit erklärendem Tooltip ===== -->

    <!--
        Tooltip im Kartenlook. Der Standard-Tooltip von WPF bricht Text nicht um
        und ist für mehrere Absätze zu schmal - daher eigene Vorlage mit MaxWidth.
    -->
    <Style x:Key="HelpTooltip" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14" Margin="6"
                            Effect="{StaticResource PopupShadow}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Runder Fragezeichen-Knopf; der Inhalt erscheint beim Überfahren. -->
    <Style x:Key="HelpBadge" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Der Hilfetext ist lang: früh einblenden, lange stehen lassen. -->
        <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
        <Setter Property="ToolTipService.ShowDuration" Value="120000" />
        <Setter Property="ToolTipService.Placement" Value="Left" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Das "?" im Hilfe-Knopf. -->
    <Style x:Key="HelpBadgeGlyph" TargetType="TextBlock">
        <Setter Property="Text" Value="?" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Karten (Container) ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- ===== Schaltflächen ===== -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <!--
            Alle Knöpfe tragen denselben Rahmen - auch die ohne sichtbaren.
            Sonst fielen gefüllte Knöpfe 2 px kleiner aus als umrandete und
            säßen in gemeinsamen Zeilen nicht auf einer Linie.
        -->
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Navigation (Seitenleiste) ===== -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Border x:Name="ActiveBar" Width="3" CornerRadius="2" Margin="-6,1,0,1"
                                    HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverWashBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Eingabefelder ===== -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <!--
                            Kein Margin aus Padding: Die Textdarstellung wertet
                            TextBox.Padding bereits selbst aus. Beides zusammen
                            hatte den Innenabstand verdoppelt - das Feld war
                            dadurch 14 px höher als die Knöpfe daneben.
                        -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MultilineInputBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- ===== Auswahlfelder (ComboBox) ===== -->
    <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}" Margin="3,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverWashBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentTintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <!--
            Keine feste Höhe: Der Innenabstand ergibt dieselbe Höhe wie bei
            Knöpfen und Eingabefeldern. Dort kommen zu 7 px Abstand noch 1 px
            Rahmen; hier zeichnet den Rahmen der innen liegende ToggleButton,
            der nicht in die Größenberechnung eingeht - deshalb 8 px.
            Rechts bleibt Platz für den Pfeil.
        -->
        <Setter Property="Padding" Value="12,8,32,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--
                            Flächen- und Rahmenfarbe müssen hier durchgereicht
                            werden: Im Template des ToggleButton bezieht sich
                            TemplateBinding auf den ToggleButton selbst, nicht
                            auf die ComboBox - sonst zeichnet er sein graues
                            Standardaussehen.
                        -->
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,13,0" Fill="{StaticResource InkMutedBrush}"
                              Data="M0,0 L8,0 L4,5 Z" />
                        <Popup x:Name="Popup" Placement="Bottom" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,4,0,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Effect="{StaticResource PopupShadow}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" Margin="0,3" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentSubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Ziehbarer Trenner (GridSplitter) ===== -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Background="{StaticResource HairlineBrush}"
                                CornerRadius="3" Width="46" Height="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Grip" Property="Width" Value="70" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Trenner für Spalten (senkrechter Griff), z. B. Seitenleiste ↔ Inhalt. -->
    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Background="{StaticResource HairlineBrush}"
                                CornerRadius="3" Width="4" Height="46"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Grip" Property="Height" Value="70" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Statistik-Balken (dünne Marke, gerundetes Datenende) ===== -->
    <Style x:Key="StatBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid ===== -->
    <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="36" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverWashBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <!-- Mehrfachauswahl wie im Datei-Explorer: Strg = einzeln zu-/abwählen,
             Umschalt = Bereich auswählen. -->
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource GridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource GridRow}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== TabControl (Unterstreichungs-Tabs) ===== -->
    <Style x:Key="EditorTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Background="Transparent"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="14,9">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,16,0,0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EditorTabItem}" />
    </Style>

    <!--
        Reiterleiste mit Seitentitel in einer Zeile: Der Titel steht links, die
        Reiter schliessen unmittelbar rechts daran an. Spart die separate
        Kopfzeile und laesst alle Ansichten gleich aussehen.

        Tag traegt den Titel - entweder als Text oder als beliebiger Inhalt,
        etwa Titel samt Hilfe-Fragezeichen. Ueber
        controls:TabHeaderExtras.RightContent lassen sich rechts Bedienelemente
        anfuegen (z. B. "Aktualisieren").
    -->
    <Style x:Key="TitledTabControl" TargetType="TabControl"
           BasedOn="{StaticResource EditorTabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <!--
                                Als ContentPresenter statt TextBlock, damit neben
                                reinem Text auch zusammengesetzte Titel moeglich
                                sind. Reiner Text erhaelt ueber den impliziten
                                Stil dieselbe Titeloptik wie zuvor.
                            -->
                            <ContentPresenter DockPanel.Dock="Left"
                                              Content="{TemplateBinding Tag}"
                                              VerticalAlignment="Center" Margin="0,0,16,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <ContentPresenter DockPanel.Dock="Right"
                                              VerticalAlignment="Center" Margin="16,0,0,0"
                                              Content="{Binding Path=(controls:TabHeaderExtras.RightContent),
                                                                RelativeSource={RelativeSource TemplatedParent}}" />

                            <!-- Unten ausgerichtet, damit der Aktivbalken auf der
                                 Grundlinie des Titels sitzt. -->
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom" />
                        </DockPanel>

                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
