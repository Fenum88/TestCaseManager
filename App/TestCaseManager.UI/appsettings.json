{
  "ConnectionStrings": {
    "TestCaseManagerDatabase": "Host=localhost;Port=5433;Database=testcasemanager;Username=postgres;Password=postgres"
  },
  "TestCaseFiles": {
    "RootPath": "",
    "ImportOutputSection": false
  },
  "CalculationSystems": {
    "FolderPath": "",
    "Systems": [
      {
        "Name": "Substanzwertverfahren",
        "Executable": "python",
        "ScriptFile": "substanzwert.py",
        "Version": "1.0"
      },
      {
        "Name": "Ertragswertverfahren",
        "Executable": "python",
        "ScriptFile": "ertragswert.py",
        "Version": "1.0"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/testcasemanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
