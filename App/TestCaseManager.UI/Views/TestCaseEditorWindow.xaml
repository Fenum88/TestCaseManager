<Window x:Class="TestCaseManager.UI.Views.TestCaseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TestCaseManager.UI.Converters"
        Title="{Binding WindowTitle}"
        Height="760" Width="960"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:ChangeTypeToTextConverter x:Key="ChangeTypeToText" />
        <converters:UtcToLocalTextConverter x:Key="UtcToLocalText" />
        <converters:FileSizeConverter x:Key="FileSize" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource EditorTabControl}" Margin="0,12,0,0">

            <!-- Stammdaten -->
            <TabItem Header="Stammdaten">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="Name *" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Beschreibung" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                            <TextBox Style="{StaticResource MultilineInputBox}" Height="110"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Version *" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding SelectedStatus}"
                                              DisplayMemberPath="Label" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kategorie" Style="{StaticResource FieldLabel}" />
                                    <ComboBox IsEditable="True"
                                              Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding CategorySuggestions}"
                                              ToolTip="Bestehende wählen oder neue eingeben" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tags (durch Komma getrennt)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="z. B. Regression, Grenzwert, Zins" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Parameter -->
            <TabItem Header="Eingabeparameter">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,0,10">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddParameterCommand}" Content="+ Parameter" />
                            <TextBlock Text="Beliebig viele Eingabewerte pro Testfall"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource ModernGrid}"
                                  ItemsSource="{Binding Parameters}"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name *" Binding="{Binding Name}" Width="1.4*" />
                                <DataGridComboBoxColumn Header="Datentyp" Width="130"
                                                        SelectedValueBinding="{Binding DataType}"
                                                        SelectedValuePath="Value"
                                                        DisplayMemberPath="Label">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.DataTypeOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.DataTypeOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="1.4*" />
                                <DataGridTextColumn Header="Standardwert" Binding="{Binding DefaultValue}" Width="*" />
                                <DataGridCheckBoxColumn Header="Pflicht" Binding="{Binding IsRequired}" Width="70" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="1.4*" />
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Parameter entfernen"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveParameterCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Erwartete Ergebnisse -->
            <TabItem Header="Erwartete Ergebnisse">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,0,10">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddExpectedResultCommand}" Content="+ Ergebnis" />
                            <TextBlock Text="Beliebig viele erwartete Ergebnisse pro Testfall"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource ModernGrid}"
                                  ItemsSource="{Binding ExpectedResults}"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name *" Binding="{Binding Name}" Width="1.4*" />
                                <DataGridComboBoxColumn Header="Datentyp" Width="130"
                                                        SelectedValueBinding="{Binding DataType}"
                                                        SelectedValuePath="Value"
                                                        DisplayMemberPath="Label">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.DataTypeOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.DataTypeOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="Erwarteter Wert *" Binding="{Binding ExpectedValue}" Width="1.4*" />
                                <DataGridTextColumn Header="Toleranz" Binding="{Binding Tolerance}" Width="90" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="1.4*" />
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" ToolTip="Ergebnis entfernen"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveExpectedResultCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Anhänge -->
            <TabItem Header="Anhänge">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,0,10">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddAttachmentCommand}" Content="+ Datei hinzufügen" />
                            <TextBlock Text="Dokumente, Bilder, PDFs (max. 25 MB)"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource ModernGrid}"
                                  ItemsSource="{Binding Attachments}"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}"
                                                    IsReadOnly="True" Width="2*" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding ContentType}"
                                                    IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Größe" Width="90" IsReadOnly="True"
                                                    Binding="{Binding FileSize, Converter={StaticResource FileSize}}" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="1.6*" />
                                <DataGridTemplateColumn Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="⭳" ToolTip="Speichern unter …"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        FontSize="15" Margin="0,0,6,0"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        Command="{Binding DataContext.ExportAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" ToolTip="Anhang entfernen"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Historie -->
            <TabItem Header="Historie">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="6">
                    <DataGrid Style="{StaticResource ModernGrid}"
                              ItemsSource="{Binding History}"
                              CanUserSortColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeitpunkt" Width="150"
                                                Binding="{Binding ChangedAt, Converter={StaticResource UtcToLocalText}}" />
                            <DataGridTextColumn Header="Aktion" Width="90"
                                                Binding="{Binding ChangeType, Converter={StaticResource ChangeTypeToText}}" />
                            <DataGridTextColumn Header="Feld / Element" Binding="{Binding PropertyName}" Width="1.6*" />
                            <DataGridTextColumn Header="Alter Wert" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="Neuer Wert" Binding="{Binding NewValue}" Width="*" />
                            <DataGridTextColumn Header="Benutzer" Binding="{Binding ChangedBy}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Fußzeile mit Aktionen -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                    Command="{Binding CancelCommand}" Content="Abbrechen" />
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" Content="Speichern"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Grid>
</Window>
