<UserControl x:Class="TestCaseManager.UI.Views.TestScenariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TestCaseManager.UI.Controls">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" MinHeight="110" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" MinHeight="110" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Testszenarien" Style="{StaticResource PageTitle}" />
            <controls:HelpHint Margin="12,0,0,0"
                               Text="Testfälle zu Szenarien zusammenfassen und im Reiter „Berechnung“ als Ganzes durchrechnen." />
        </StackPanel>

        <!-- Aktionen -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                        Command="{Binding AddCommand}" Content="+ Neues Szenario" />
                <Button Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                        Command="{Binding RemoveCommand}" Content="Entfernen" />
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Command="{Binding ReloadCommand}" Content="Verwerfen" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" Content="💾  Speichern" />
            </StackPanel>
        </Border>

        <!-- Szenarienliste -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,2">
            <DataGrid Style="{StaticResource ModernGrid}"
                      ItemsSource="{Binding Scenarios}"
                      SelectedItem="{Binding SelectedScenario}"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="1.6*"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Beschreibung" Width="2.4*"
                                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Testfälle" Width="90" IsReadOnly="True"
                                        Binding="{Binding SelectedCount, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Ziehbarer Trenner: Liste ↔ Mitglieder -->
        <GridSplitter Grid.Row="3" Height="10" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" />

        <!-- Mitgliederauswahl des gewählten Szenarios -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           Text="Testfälle des Szenarios" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,4,0,8"
                           Text="Wählen Sie die Testfälle, die zum ausgewählten Szenario gehören." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedScenario.Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4,24,4" IsChecked="{Binding IsSelected}"
                                          Content="{Binding Number}" MinWidth="70" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Statuszeile -->
        <TextBlock Grid.Row="5" Margin="2,12,0,0"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentPressedBrush}"
                   Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
