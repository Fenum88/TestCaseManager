<UserControl x:Class="TestCaseManager.UI.Views.CalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TestCaseManager.UI.Controls">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.6*" MinHeight="100" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Berechnung" Style="{StaticResource PageTitle}" />
            <controls:HelpHint Margin="12,0,0,0"
                               Text="Berechnungssysteme aufrufen – einzeln oder alle gleichzeitig. Jedes System schreibt in einen eigenen Output-Unterordner." />
        </StackPanel>

        <!-- Ordnerauswahl + Testszenario -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Wurzelordner (enthält die Unterordner Input und Output)"
                           Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                             VerticalAlignment="Center" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}" Content="Durchsuchen …" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Testszenario (welche Testfälle gerechnet werden)"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox VerticalAlignment="Center"
                                  ItemsSource="{Binding ScenarioChoices}"
                                  SelectedItem="{Binding SelectedScenarioChoice}"
                                  DisplayMemberPath="Label"
                                  ToolTip="„Alle Testfälle“ oder ein im Reiter Testszenarien angelegtes Szenario" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Abgleichprofil (wie Zeilen zugeordnet werden)"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox VerticalAlignment="Center"
                                  ItemsSource="{Binding CompareProfileChoices}"
                                  SelectedItem="{Binding SelectedCompareProfileChoice}"
                                  DisplayMemberPath="Label"
                                  ToolTip="Profil aus Einstellungen → Abgleich; „Ohne Profil“ vergleicht rein über die Position" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Systeme + Aktionen -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Verfügbare Berechnungssysteme" Style="{StaticResource FieldLabel}" />
                <DataGrid Style="{StaticResource ModernGrid}" MaxHeight="180" Margin="0,4,0,0"
                          ItemsSource="{Binding Systems}"
                          SelectedItem="{Binding SelectedSystem}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                        <DataGridTextColumn Header="Skript" Binding="{Binding ScriptFile}" Width="1.4*" />
                        <DataGridTextColumn Header="Ausgabe-Unterordner"
                                            Binding="{Binding OutputSubfolderName, Mode=OneWay}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Command="{Binding RunSelectedCommand}"
                            Content="⚙  Ausgewähltes berechnen" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunAllCommand}"
                            Content="⚙  Alle gleichzeitig berechnen" />
                    <TextBlock Text="⏳" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPressedBrush}" />
            </StackPanel>
        </Border>

        <!-- Vergleich zweier Systeme -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Vergleich: zwei Systeme berechnen und Ausgaben abgleichen"
                           Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" VerticalAlignment="Center"
                              ItemsSource="{Binding Systems}"
                              SelectedItem="{Binding CompareSystemA}"
                              DisplayMemberPath="Name" ToolTip="System A" />
                    <TextBlock Grid.Column="2" Text="↔" FontSize="16" VerticalAlignment="Center"
                               Foreground="{StaticResource InkSecondaryBrush}" />
                    <ComboBox Grid.Column="4" VerticalAlignment="Center"
                              ItemsSource="{Binding Systems}"
                              SelectedItem="{Binding CompareSystemB}"
                              DisplayMemberPath="Name" ToolTip="System B" />
                    <Button Grid.Column="6" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunCompareCommand}"
                            Content="⇄  Vergleich starten" />
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Beide Systeme werden berechnet, danach werden ihre Ausgaben attributweise verglichen (inkl. Differenz bei Zahlen). Das Ergebnis liegt unter Output\Vergleich_A_vs_B\ in gleicher Ordnerstruktur; zusätzlich entstehen dort die Excel-Mappe _Gesamtvergleich.xlsx (Blätter Zusammenfassung und Abgleich) sowie die deutsche CSV _Gesamtvergleich.csv." />
            </StackPanel>
        </Border>

        <!-- Ziehbarer Trenner: Vergleich ↔ Protokoll -->
        <GridSplitter Grid.Row="4" Height="10" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" />

        <!-- Log-Panel -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="6" Margin="0,2,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,6,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Command="{Binding ClearLogCommand}" Content="Leeren" />
                    <TextBlock Text="Protokoll" Style="{StaticResource SectionTitle}" Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="#0B0B0B" CornerRadius="6" Margin="4,0,4,4">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#7A7A78" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D4D4D2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="#F48771" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
