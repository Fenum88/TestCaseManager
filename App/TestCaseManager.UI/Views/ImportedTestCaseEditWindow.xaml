<Window x:Class="TestCaseManager.UI.Views.ImportedTestCaseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="760" Width="960"
        MinHeight="540" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0">
            <!-- Hilfe: erklärt Bearbeitung und Datentyp-Ableitung -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Top"
                    Style="{StaticResource HelpBadge}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource HelpTooltip}">
                        <StackPanel>
                            <TextBlock Text="Attribute bearbeiten" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Die Spalte „Wert“ ist bearbeitbar – alle übrigen Angaben beschreiben die Herkunft und bleiben unverändert." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Geänderte Zeilen sind mit ● markiert und zeigen den ursprünglichen Wert an. Einzelne Änderungen lassen sich mit „Zurücknehmen“ verwerfen." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Der Datentyp wird beim Speichern neu abgeleitet: Zahlen ohne Anführungszeichen, alles andere als Text. Damit bleibt ein späteres Auslesen formatgleich." />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Geschrieben wird ausschließlich in die Datenbank. Die Dateien im Testfälle-Ordner bleiben unberührt; ein erneutes Einlesen überschreibt die Änderung wieder." />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <TextBlock Style="{StaticResource HelpBadgeGlyph}" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Suche und Änderungsaktionen -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=10}"
                         ToolTip="Suche in Entity, Spalte und Wert" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearSearchCommand}" Content="Suche zurücksetzen" />
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RevertRowCommand}" Content="↺  Zurücknehmen" />
                <Button Grid.Column="6" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RevertAllCommand}" Content="↺  Alle zurücknehmen" />
            </Grid>
        </Border>

        <!-- Attributliste, gruppiert nach Abschnitt · Datei · Entity -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
            <DataGrid Style="{StaticResource ModernGrid}"
                      ItemsSource="{Binding AttributesView}"
                      SelectedItem="{Binding SelectedRow}"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentTintBrush}" CornerRadius="4"
                                        Padding="10,6" Margin="0,10,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource InkPrimaryBrush}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} Attribute)'}"
                                                   Foreground="{StaticResource InkMutedBrush}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <!-- Markierung geänderter Zeilen: Textzeichen statt reiner Farbe. -->
                    <DataGridTextColumn Header="" Width="30" IsReadOnly="True"
                                        Binding="{Binding ChangeMarker, Mode=OneWay}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Zeile" Width="60" IsReadOnly="True"
                                        Binding="{Binding RowIndex, Mode=OneWay}" />
                    <DataGridTextColumn Header="Spalte" Width="1.4*" IsReadOnly="True"
                                        Binding="{Binding ColumnName, Mode=OneWay}" />
                    <!-- Einzige bearbeitbare Spalte. -->
                    <DataGridTextColumn Header="Wert" Width="2*"
                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Vorher" Width="1.4*" IsReadOnly="True"
                                        Binding="{Binding OriginalDisplay, Mode=OneWay}"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource InkMutedBrush}" />
                    <DataGridTextColumn Header="Datentyp" Width="110" IsReadOnly="True"
                                        Binding="{Binding DataType, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Fußzeile -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Command="{Binding CancelCommand}" IsCancel="True" Content="Schließen" />
                <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Command="{Binding SaveCommand}" Content="💾  Speichern" />
            </StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
