<UserControl x:Class="TestCaseManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,24,28,24">

        <!-- Titel und Reiter stehen in einer Zeile (siehe TitledTabControl). -->
        <TabControl Style="{StaticResource TitledTabControl}" Tag="Einstellungen">

            <!-- ===== Berechnungssysteme ===== -->
            <TabItem Header="Berechnungssysteme">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                    Command="{Binding AddCommand}" Content="+ System hinzufügen" />
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding BrowseScriptCommand}" Content="Skript wählen …" />
                            <Button Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                                    Command="{Binding RemoveCommand}" Content="Entfernen" />
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                    Command="{Binding ReloadCommand}" Content="Verwerfen" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}" Content="💾  Speichern" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <DataGrid Style="{StaticResource ModernGrid}"
                                  ItemsSource="{Binding Systems}"
                                  SelectedItem="{Binding SelectedSystem}"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Width="1.6*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Version" Width="90"
                                                    Binding="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Programm" Width="1.1*"
                                                    Binding="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Skript" Width="1.6*"
                                                    Binding="{Binding ScriptFile, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Aufruf (Argumente)" Width="2*"
                                                    Binding="{Binding ArgumentsTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="So wird ein System aufgerufen" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Aufgerufen wird: Programm + Argumente. Im Feld „Aufruf“ stehen die Platzhalter:" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" FontFamily="Consolas"
                                       Text="{}{script} = Skriptpfad   ·   {input} = Eingabeordner (Input)   ·   {output} = Ausgabeordner" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" FontFamily="Consolas"
                                       Text="Standard: {script} {input} {output}     Beispiel: {script} --in {input} --out {output}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap">
                                <Run Text="Relative Skriptpfade beziehen sich auf den Ordner: " />
                                <Run Text="{Binding CalculationFolder, Mode=OneWay}" FontFamily="Consolas" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Margin="2,12,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPressedBrush}"
                               Text="{Binding StatusMessage}" />
                </Grid>
            </TabItem>

            <!-- ===== Abgleich: Profile mit Schlüsselregeln ===== -->
            <TabItem Header="Abgleich">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.2*" MinHeight="110" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Profil-Aktionen -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                      <DockPanel>
                        <!-- Hilfe: erklärt Zuordnung und CSV-Aufbau beim Überfahren -->
                        <Border DockPanel.Dock="Right" VerticalAlignment="Top"
                                Style="{StaticResource HelpBadge}">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource HelpTooltip}">
                                    <StackPanel>
                                        <TextBlock Text="Wie der Abgleich Zeilen zuordnet"
                                                   Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                   Text="Ohne Regel werden die Zeilen einer Entität über ihre Position verglichen (Zeile 0 gegen Zeile 0). Das meldet Unterschiede, sobald ein System dieselben Einträge in anderer Reihenfolge liefert." />
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Mit einer Regel zählt stattdessen der Schlüsselwert: Einträge mit gleichem Schlüssel werden einander zugeordnet – unabhängig von ihrer Position. Mehrere Attribute ergeben einen zusammengesetzten Schlüssel." />
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Welches Profil gilt, wird im Reiter „Berechnung“ je Vergleichslauf gewählt." />
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="CSV-Aufbau: eine Zeile je Regel (Profil; Beschreibung; Entität; Schlüsselattribute), mehrere Schlüssel innerhalb der Zelle mit Komma. Beim Import ersetzen gleichnamige Profile die vorhandenen, neue kommen hinzu – übernommen wird erst mit „Speichern“." />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <TextBlock Style="{StaticResource HelpBadgeGlyph}" />
                        </Border>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                                        Command="{Binding AddCompareProfileCommand}" Content="+ Profil hinzufügen" />
                                <Button Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                                        Command="{Binding RemoveCompareProfileCommand}" Content="Profil entfernen" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding ReloadCommand}" Content="Verwerfen" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCompareProfilesCommand}" Content="💾  Speichern" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="CSV:" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding ExportAllCompareProfilesCommand}"
                                        Content="⭳  Alle exportieren" />
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                        Command="{Binding ExportSelectedCompareProfileCommand}"
                                        Content="⭳  Auswahl exportieren" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ImportCompareProfilesCommand}"
                                        Content="⭱  Importieren" />
                            </StackPanel>
                        </StackPanel>
                      </DockPanel>
                    </Border>

                    <!-- Profilliste -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Abgleichprofile"
                                       Style="{StaticResource SectionTitle}" Margin="10,8,0,8" />
                            <DataGrid Style="{StaticResource ModernGrid}"
                                      ItemsSource="{Binding CompareProfiles}"
                                      SelectedItem="{Binding SelectedCompareProfile}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Width="1.6*"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Beschreibung" Width="3*"
                                                        Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Regeln" Width="80" IsReadOnly="True"
                                                        Binding="{Binding RuleCount, Mode=OneWay}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="10" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows" />

                    <!-- Regeln des gewählten Profils -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,2,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="10,8,6,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"
                                            Command="{Binding AddCompareKeyCommand}" Content="+ Regel" />
                                    <Button Style="{StaticResource DangerButton}" Padding="10,4"
                                            Command="{Binding RemoveCompareKeyCommand}" Content="Regel entfernen" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="Regeln des Profils" />
                                    <Run Text="{Binding SelectedCompareProfile.Name, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </DockPanel>
                            <DataGrid Style="{StaticResource ModernGrid}"
                                      ItemsSource="{Binding SelectedCompareProfile.Rules}"
                                      SelectedItem="{Binding SelectedCompareKey}"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Entität" Width="1.4*"
                                                        Binding="{Binding Entity, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="Schlüsselattribute (kommagetrennt)" Width="3*"
                                                        Binding="{Binding KeyColumns, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Margin="2,12,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentPressedBrush}"
                               Text="{Binding CompareKeyStatus}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
