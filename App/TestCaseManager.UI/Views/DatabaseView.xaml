<UserControl x:Class="TestCaseManager.UI.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TestCaseManager.UI.Controls">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Unterreiter wie im Reiter „Einstellungen": Titel und Reiter stehen
            in einer Zeile, rechts die Aktion zum Aktualisieren.
        -->
        <TabControl Grid.Row="0" Style="{StaticResource TitledTabControl}">
            <TabControl.Tag>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Datenbank" />
                    <!-- Hilfe: was dieser Reiter zeigt und wie gefiltert wird -->
                    <controls:HelpHint Margin="12,0,0,0"
                                       Text="Alle gespeicherten Testfälle und ihre Attribute – filterbar über Ausdrücke.&#10;&#10;Ein Doppelklick auf eine Zeile öffnet den Testfall zum Bearbeiten; gespeicherte Änderungen wirken direkt in der Datenbank.&#10;&#10;Der Reiter „Abgleichprofile“ zeigt die gemeinsam genutzten Profile. Gepflegt werden sie unter „Einstellungen → Abgleich“."
                                       DetailText="Operatoren:   =  !=  &lt;  &gt;  &lt;=  &gt;=  ~ (enthält)&#10;Verknüpfung:  AND, OR, ( )&#10;Beispiel:     tuer=2 AND nachname=Bongo" />
                </StackPanel>
            </TabControl.Tag>
            <controls:TabHeaderExtras.RightContent>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" Content="Aktualisieren" />
            </controls:TabHeaderExtras.RightContent>

            <!-- ===== Testfälle ===== -->
            <TabItem Header="Testfälle">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter über Attributausdrücke -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                     VerticalAlignment="Center"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="z. B. tuer=2 AND nachname=Bongo">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding ApplyFilterCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ApplyFilterCommand}" Content="🔍  Filtern" />
                            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetFilterCommand}" Content="Zurücksetzen" />
                        </Grid>
                    </Border>

                    <!-- Ein Testfall je Zeile; Spalten (Entität · Attribut) entstehen dynamisch. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                        <DataGrid x:Name="AttributeGrid" Style="{StaticResource ModernGrid}"
                                  ItemsSource="{Binding RowsView}" IsReadOnly="True"
                                  SelectedItem="{Binding SelectedRow}"
                                  HorizontalScrollBarVisibility="Auto">
                            <!-- Doppelklick öffnet den Testfall zum Bearbeiten. -->
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding OpenSelectedCommand}" />
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Abgleichprofile (nur lesend) ===== -->
            <TabItem Header="Abgleichprofile" IsSelected="{Binding ShowProfiles, Mode=TwoWay}">
                <Border Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
                    <DataGrid Style="{StaticResource ModernGrid}"
                              ItemsSource="{Binding ProfileRows}" IsReadOnly="True"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profil" Width="1.6*"
                                                Binding="{Binding Profile, Mode=OneWay}" />
                            <!-- Lange Beschreibungen werden gekürzt; der Tooltip zeigt sie vollständig. -->
                            <DataGridTextColumn Header="Beschreibung" Width="3*"
                                                Binding="{Binding Description, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Description}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Entität" Width="1.2*"
                                                Binding="{Binding Entity, Mode=OneWay}" />
                            <DataGridTextColumn Header="Schlüsselattribute" Width="1.8*"
                                                Binding="{Binding KeyColumns, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Statuszeile -->
        <TextBlock Grid.Row="1" Margin="2,12,0,0" FontSize="13" FontWeight="SemiBold"
                   Text="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
