<Window x:Class="TestCaseManager.UI.Views.ImportedTestCaseDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="720" Width="900"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding AuditInfo}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Kennzahlen -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,36,0">
                    <TextBlock Text="Entities" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding EntityCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimaryBrush}" />
                </StackPanel>
                <StackPanel Margin="0,0,36,0">
                    <TextBlock Text="Zeilen" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding RowCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimaryBrush}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Attribute" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding AttributeCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Suche -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=10}"
                     ToolTip="Suche in Entity, Spalte und Wert" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearSearchCommand}" Content="Zurücksetzen" />
        </Grid>

        <!-- Attributliste, gruppiert nach Abschnitt · Datei · Entity -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,0">
            <DataGrid Style="{StaticResource ModernGrid}"
                      ItemsSource="{Binding Attributes}"
                      IsReadOnly="True">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentTintBrush}" CornerRadius="4"
                                        Padding="10,6" Margin="0,10,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource InkPrimaryBrush}" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} Attribute)'}"
                                                   Foreground="{StaticResource InkMutedBrush}" FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Zeile" Width="70"
                                        Binding="{Binding RowIndex, Mode=OneWay}" />
                    <DataGridTextColumn Header="Spalte" Width="1.4*"
                                        Binding="{Binding ColumnName, Mode=OneWay}" />
                    <DataGridTextColumn Header="Wert" Width="2*"
                                        Binding="{Binding Value, Mode=OneWay}" />
                    <DataGridTextColumn Header="Datentyp" Width="110"
                                        Binding="{Binding DataType, Mode=OneWay}" />
                    <DataGridTextColumn Header="In Anführungszeichen" Width="150"
                                        Binding="{Binding QuotedDisplay, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Fußzeile -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    IsCancel="True" IsDefault="True" Content="Schließen" />
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center">
                <Run Text="{Binding VisibleCount, Mode=OneWay}" />
                <Run Text="Attribut(e) angezeigt · nur Lesezugriff, Pflege über Import / Export" />
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
