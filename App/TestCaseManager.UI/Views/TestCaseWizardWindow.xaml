<Window x:Class="TestCaseManager.UI.Views.TestCaseWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuer Testfall"
        Height="720" Width="900"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Neuer Testfall" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding StepTitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Schritt 1: Entities -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="180">
                            <TextBlock Text="Testfallnummer *" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bezeichnung der Eingabedatei" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Entities auswählen (Schablone aus der Datenbank)"
                               Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Wählen Sie die benötigten Entities. Eigene Entities lassen sich unten ergänzen." />
                </StackPanel>

                <!-- Neue Entity ergänzen -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}" VerticalAlignment="Center"
                             Text="{Binding NewEntityName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name einer eigenen Entity" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddEntityCommand}" Content="+ Entity ergänzen" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,5" IsChecked="{Binding IsSelected}"
                                          Content="{Binding Name}" FontSize="13" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Schritt 2: Attribute -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource MutedText}"
                           Text="Wählen Sie je Entity die benötigten Attribute. Eigene Attribute lassen sich ergänzen." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedEntities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                        Padding="14" Margin="0,0,0,12"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Attributes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,4,20,4" IsChecked="{Binding IsSelected}"
                                                              Content="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                                     Text="{Binding NewAttributeName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Name eines eigenen Attributs" />
                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding AddAttributeCommand}"
                                                    Content="+ Attribut ergänzen" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Schritt 3: Werte -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Style="{StaticResource MutedText}"
                           Text="Tragen Sie die Werte ein. Je Entity können mehrere Zeilen erfasst werden." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ValueBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                        Padding="14" Margin="0,0,0,12"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                                    Padding="10,4" Command="{Binding AddRowCommand}"
                                                    Content="+ Zeile" />
                                            <TextBlock Text="{Binding EntityName}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource InkPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Spaltenüberschriften -->
                                        <ItemsControl ItemsSource="{Binding Columns}" Margin="0,0,0,2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Width="150" Margin="0,0,8,0"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Datenzeilen -->
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Width="142" Margin="0,0,8,0"
                                                                             Style="{StaticResource InputBox}"
                                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Style="{StaticResource SecondaryButton}"
                                                                Padding="8,2" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.RemoveRowCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" ToolTip="Zeile entfernen" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Fußzeile mit Navigation -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" Content="Abbrechen" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding BackCommand}" Content="◀  Zurück" />
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding NextCommand}" Content="Weiter  ▶" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding FinishCommand}" Content="✓  Testfall anlegen" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
