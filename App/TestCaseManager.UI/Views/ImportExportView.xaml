<UserControl x:Class="TestCaseManager.UI.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TestCaseManager.UI.Converters"
             xmlns:controls="clr-namespace:TestCaseManager.UI.Controls">

    <UserControl.Resources>
        <converters:UtcToLocalTextConverter x:Key="UtcToLocalText" />
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.6*" MinHeight="100" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Datei-Import / -Export" Style="{StaticResource PageTitle}" />
            <controls:HelpHint Margin="12,0,0,0"
                               Text="Testfälle aus dem Ordner Testfälle einlesen und aus der Datenbank wiederherstellen." />
        </StackPanel>

        <!-- Ordnerauswahl -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Wurzelordner (enthält die Unterordner Input und Output)"
                           Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                             VerticalAlignment="Center"
                             Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}" Content="Durchsuchen …" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Aktionen + prominente Statuszeile -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Command="{Binding ImportCommand}" Content="⭳  Einlesen (Dateien → Datenbank)" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Command="{Binding ExportCommand}" Content="⭱  Auslesen (Datenbank → Dateien)" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Command="{Binding RefreshCommand}" Content="Aktualisieren" />
                    <Button Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                            Command="{Binding DeleteSelectedCommand}" Content="Auswahl löschen"
                            ToolTip="Löscht den markierten Testfall aus der Datenbank (Dateien bleiben erhalten)" />
                    <Button Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteAllCommand}" Content="Alle löschen"
                            ToolTip="Löscht alle Datei-Testfälle aus der Datenbank (Dateien bleiben erhalten)" />
                    <TextBlock Text="⏳" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPressedBrush}" />
            </StackPanel>
        </Border>

        <!-- Übersicht der eingelesenen Testfälle -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="In der Datenbank gespeicherte Datei-Testfälle"
                           Style="{StaticResource SectionTitle}" Margin="10,8,0,8" />
                <DataGrid Style="{StaticResource ModernGrid}" ItemsSource="{Binding ImportedTestCases}"
                          SelectedItem="{Binding SelectedTestCase}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Testfallnummer" Binding="{Binding Number}" Width="1.4*" />
                        <DataGridTextColumn Header="Eingabedateien" Binding="{Binding InputFileCount}" Width="*" />
                        <DataGridTextColumn Header="Ausgabedateien" Binding="{Binding OutputFileCount}" Width="*" />
                        <DataGridTextColumn Header="Entities" Binding="{Binding EntityCount}" Width="*" />
                        <DataGridTextColumn Header="Zeilen" Binding="{Binding RowCount}" Width="*" />
                        <DataGridTextColumn Header="Werte" Binding="{Binding ValueCount}" Width="*" />
                        <DataGridTextColumn Header="Eingelesen von" Binding="{Binding ImportedBy}" Width="1.2*" />
                        <DataGridTextColumn Header="Zeitpunkt" Width="150"
                                            Binding="{Binding ImportedAt, Converter={StaticResource UtcToLocalText}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Ziehbarer Trenner: Übersicht ↔ Protokoll -->
        <GridSplitter Grid.Row="4" Height="10" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows" />

        <!-- Log-Panel -->
        <Border Grid.Row="5" Style="{StaticResource Card}" Padding="6" Margin="0,2,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,6,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" Command="{Binding ClearLogCommand}" Content="Leeren" />
                    <TextBlock Text="Protokoll" Style="{StaticResource SectionTitle}" Margin="0"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="#0B0B0B" CornerRadius="6" Margin="4,0,4,4">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#7A7A78" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D4D4D2" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="#F48771" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
